\PYG{c}{\PYGZsh{} Проверка экспоненциальности}
\PYG{k}{function}\PYG{+w}{ }\PYG{n}{check\PYGZus{}exponential}\PYG{p}{(}\PYG{n}{intervals}\PYG{p}{)}
\PYG{+w}{    }\PYG{c}{\PYGZsh{} Интервалы между событиями}
\PYG{+w}{    }\PYG{n}{diffs}\PYG{+w}{ }\PYG{o}{=}\PYG{+w}{ }\PYG{n}{diff}\PYG{p}{([}\PYG{l+m+mi}{0}\PYG{p}{;}\PYG{+w}{ }\PYG{n}{intervals}\PYG{p}{])}
