\PYG{+w}{    }\PYG{n}{test}\PYG{+w}{ }\PYG{o}{=}\PYG{+w}{ }\PYG{n}{ExactOneSampleKSTest}\PYG{p}{(}\PYG{n}{diffs}\PYG{p}{,}\PYG{+w}{ }\PYG{n}{Exponential}\PYG{p}{(}\PYG{l+m+mi}{1}\PYG{o}{/}\PYG{n}{mean}\PYG{p}{(}\PYG{n}{diffs}\PYG{p}{)))}
